# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Encryption key for storing private keys (any random 32+ char string)
BOT_ENCRYPTION_KEY=change_this_to_a_random_string_32chars

# Your Telegram ID (get from @userinfobot) — you'll be the admin
ADMIN_ID=your_telegram_id

